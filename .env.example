
# PostgreSQL
POSTGRES_USER=invix
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=shop
POSTGRES_PORT=5433

# MinIO S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_password
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=products
MINIO_SECURE=false

# Backend
ADMIN_API_TOKEN=replace_with_secure_random_token

# Telegram Bot
BOT_TOKEN=replace_with_botfather_token
TELEGRAM_ADMIN_ID=123456789
WEBHOOK_SECRET=replace_with_random_webhook_secret

# Public HTTPS URL for Telegram Mini App
MINI_APP_URL=https://your-public-domain.example/

# Local backend URL
BACKEND_URL=http://127.0.0.1:8001
